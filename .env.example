# ============================================================
# Sentry PM — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================


# ─── Django Core ────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate one at: https://djecrety.ir/
SECRET_KEY=django-insecure-change-me-to-a-long-random-string-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts in production
# Example: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=*


# ─── Database ───────────────────────────────────────────────
# Options: 'sqlite' | 'postgresql'
# Use 'sqlite' for quick setup (no database server needed)
# Use 'postgresql' for production deployments
DB_ENGINE=sqlite

# PostgreSQL settings (only needed if DB_ENGINE=postgresql)
POSTGRES_DB=sentry_pm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# ─── Media Files ────────────────────────────────────────────
# Directory for uploaded files (avatars, attachments)
# Leave empty to use the default 'media/' folder
MEDIA_ROOT=


# ─── Security (Production Only) ─────────────────────────────
# Uncomment these in production:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
